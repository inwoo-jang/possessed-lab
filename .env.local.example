# POSSESSED — 환경 변수 예시
# 이 파일을 복사하여 .env.local을 생성하세요
# .env.local은 절대 git에 커밋하지 마세요

# LLM API (LIVE_EXPERIMENT 모드에서만 필요)
# 서버 전용 — NEXT_PUBLIC_ 접두사 사용 금지
OPENAI_API_KEY=

# 데이터베이스
# 로컬 개발: SQLite 파일 경로 (자동 생성됨)
DATABASE_URL=./possessed.db

# 배포: PostgreSQL 연결 문자열
# DATABASE_URL=postgresql://user:password@host:5432/possessed
